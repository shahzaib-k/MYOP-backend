PORT=5000
# Recommended: copy your Realtime Database URL from Firebase Console.
FIREBASE_DATABASE_URL=https://make-your-own-platter-default-rtdb.asia-southeast1.firebasedatabase.app

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: this admin account is created on server start if it does not exist.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@platter.com
ADMIN_PASSWORD=replace-with-a-strong-password
