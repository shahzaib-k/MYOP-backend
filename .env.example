PORT=5000
# Recommended: copy your Realtime Database URL from Firebase Console.
FIREBASE_DATABASE_URL=https://make-your-own-platter-default-rtdb.asia-southeast1.firebasedatabase.app

# Required: from your Firebase service account JSON (Project settings > Service
# accounts > Generate new private key). Not read from a local file so this
# works on serverless hosts (e.g. Vercel) that only provide env vars.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n sequences literal (as they appear in the JSON) and wrap in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: this admin account is created on server start if it does not exist.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@platter.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional but recommended: an Expo access token for sending push notifications.
# Create one at https://expo.dev/accounts/[account]/settings/access-tokens.
# Notifications still send without it, but Expo may rate-limit unauthenticated requests.
EXPO_ACCESS_TOKEN=

# Stripe - SANDBOX ONLY. Use test keys from https://dashboard.stripe.com/test/apikeys
# (the server refuses any secret key that does not start with sk_test_).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional, defaults to pkr.
STRIPE_CURRENCY=pkr
